{
  "name": "insightly-se-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASKS",
        "class_name": "TaskDO"
      },
      {
        "name": "PACER",
        "class_name": "PacerDO"
      },
      {
        "name": "GATE",
        "class_name": "GateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PacerDO",
        "GateDO"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "META",
      "id": "612e5ea1de6f41f488e0f54fa3e08551"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "insightly-se-exports"
    }
  ],
  "vars": {}
}
