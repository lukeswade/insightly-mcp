{
  "name": "insightly-se-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASKS",
        "class_name": "TaskDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskDO"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "insightly-se-exports"
    }
  ],
  "vars": {
    "EXPORTS_PUBLIC_BASE": "https://pub-a1985eb80495467ead59f2ff3f21003a.r2.dev"
  }
}
